rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
